# Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adaptive_quiz
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Quiz / Seeding
# Salt used when hashing/verifying correct answers. Change in production.
QUIZ_ANSWER_SALT=dev-salt-change-me
# Optional: how many questions to seed (default: 80)
SEED_QUESTION_COUNT=80

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Leaderboard caching (Redis)
LEADERBOARD_SNAPSHOT_LIMIT=25
LEADERBOARD_SNAPSHOT_TTL_SECONDS=5

# General caching (Redis)
SESSION_USER_TTL_SECONDS=3600
USER_STATE_TTL_SECONDS=15
QUESTION_POOL_TTL_SECONDS=21600
QUESTION_TTL_SECONDS=86400
